# /operacao/firewall.unidades/firewall_unidades_v2.conf
SERVER_IP="192.168.11.1"

DNS_TIMEOUT=4
DNS_JOBS=8
DNS_CACHE_MAX_AGE=604800
DNS_STRICT=0
OPTIMIZE_NETWORKS=1
ALLOW_FIREWALLD=0
BACKUP_KEEP=10

# v2.2 - papéis de interfaces
INTERFACE_POLICY_MODE="compat"       # compat | roles
INTERFACE_MISSING_POLICY="warn"      # ignore | warn | error
WAN_INTERFACES="eth1 enX1"
LAN_INTERFACES="eth0 em1 enX0 eno1"
VPN_INTERFACES="tap0 tap1 wg0"
INPUT_TRUSTED_INTERFACES="eth0 em1 enX0 eno1 tap0 tap1 wg0"
INPUT_TRUSTED_SOURCES="10.80.0.0/16 172.20.0.0/24"

LOCAL_INPUT_RULES=(
    "name=legacy-port300-eth0 iface=eth0 proto=tcp port=300 src=any"
    "name=legacy-port300-eth1-lan iface=eth1 proto=tcp port=300 src=192.168.1.0/24"
    "name=legacy-port300-eth1-public iface=eth1 proto=tcp port=300 src=200.195.133.27/32"
    "name=legacy-port300-eth1-vpn iface=eth1 proto=tcp port=300 src=10.100.1.0/24"
    "name=legacy-port300-enX0 iface=enX0 proto=tcp port=300 src=any"
    "name=legacy-port300-enX1-lan iface=enX1 proto=tcp port=300 src=192.168.1.0/24"
    "name=legacy-port300-enX1-public iface=enX1 proto=tcp port=300 src=200.195.133.27/32"
    "name=legacy-port300-enX1-vpn iface=enX1 proto=tcp port=300 src=10.100.1.0/24"
)

# v2.3 - destinos DNS dinâmicos (u:)
# Exemplo em regras_firewall.conf: u: pastrello.ddns.net
DYNAMIC_DNS_ENABLE=1
DYNAMIC_DNS_MIN_INTERVAL=30
DYNAMIC_DNS_MAX_INTERVAL=300
DYNAMIC_DNS_TTL_DIVISOR=2
DYNAMIC_DNS_GRACE=300
DYNAMIC_DNS_STALE_MAX=3600
DYNAMIC_DNS_FAIL_POLICY="keep"       # keep | drop
DYNAMIC_DNS_LOCK_TIMEOUT=20
DYNAMIC_DNS_SERVICE_NAME="firewall-dnswatch.service"

ALLOW_RFC1918_192_DST=1
LOG_TRAFFIC=1
LOG_NEW_ONLY=1
LOG_RATE="50/second"
LOG_BURST=200
EXCLUDE_LOG_NET_1="192.168.0.0/16"
EXCLUDE_LOG_NET_2="10.80.0.0/16"
EXCLUDE_LOG_NET_3="172.16.0.0/12"

WG_FORWARD_ENABLE=1
WG_FORWARD_DST="172.20.0.200/32"
WG_FORWARD_TCP_PORTS="1:1024 3389"
